# ---------------------------------------------------------------
# Copiá este archivo como .env y llená los valores.
# .env NO se versiona ni se comparte. Ver CONTRACT.md §14.1
# ---------------------------------------------------------------

# URL del proyecto Supabase. Panel → Project Settings → API → Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave PUBLICABLE (sb_publishable_...). Es pública por diseño: viaja al
# navegador y la protege Row Level Security. Es la única que usa el frontend.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Dominio institucional. NO controla quién puede registrarse: eso lo decide
# la nómina que el docente precarga en el panel. Este valor se usa solo para
# advertir, al cargar la lista, que un correo no parece institucional —
# atrapa errores de digitación sin dejar a nadie fuera de su propia clase.
DOMINIO_INSTITUCIONAL=@monicaherrera.edu.sv

# ---------------------------------------------------------------
# NO agregues aquí la clave sb_secret_... (antes service_role).
# Ignora RLS y da acceso total a la base: datos personales de
# estudiantes, respuestas correctas y calificaciones.
# Este proyecto NO la necesita. Las migraciones se aplican desde el
# SQL Editor del panel o con el CLI tras `supabase login`.
# ---------------------------------------------------------------
