# ---------------------------------------------------------------
# Copiá este archivo como .env y llená los valores PARA DESARROLLO LOCAL.
# .env NO se versiona (ver .gitignore). Ver CONTRACT.md §14.
#
# EN PRODUCCIÓN (Render) NO se usa este archivo: cada variable se carga
# en el panel de Render → tu servicio → Environment → Add Environment
# Variable, marcada como "secret". Render la cifra e inyecta al proceso;
# nunca toca este repo. `render.yaml` ya declara cuáles hacen falta.
# ---------------------------------------------------------------

# Postgres local para desarrollo. Dos URLs con roles distintos (§3.1):
# DATABASE_URL          → rol dueño (postgres) — SOLO para correr sql/00..06 migraciones
# DATABASE_URL_APP      → rol app_runtime (no dueño, RLS forzado) — la que usa el proceso Express
# En Render, el segundo se pega a mano en Environment desde la URL interna de la DB;
# el primero solo se usa una vez para migrar y no va en Environment del servicio web.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codigo_cafe
DATABASE_URL_APP=postgres://app_runtime:app_runtime_pw@localhost:5432/codigo_cafe
POSTGRES_DB=codigo_cafe
POSTGRES_USER=app_runtime
POSTGRES_PASSWORD=app_runtime_pw

# Resend (resend.com) — envío del código OTP por correo. Creá la cuenta,
# generá una API key en resend.com/api-keys, y pegala SOLO acá para probar
# en tu máquina. Para producción va en el panel de Render, nunca en un
# archivo de este repo.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Correo remitente verificado en Resend (requiere verificar un dominio propio,
# o usar el dominio de prueba que Resend asigna mientras tanto).
RESEND_FROM="El Código del Café <auditoria@tu-dominio-verificado.com>"

# Secreto para firmar la cookie de sesión httpOnly. Generalo una vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y NUNCA lo reutilices entre entornos (uno para local, otro para Render).
COOKIE_SECRET=cambia-esto-por-64-caracteres-hexadecimales-aleatorios

# Puerto del servidor Express en local. Render define su propio PORT y lo
# inyecta solo; el servidor debe leer process.env.PORT con este como fallback.
PORT=3000

# Dominio institucional. NO controla quién puede registrarse: eso lo decide
# la nómina que el docente precarga en el panel. Este valor se usa solo para
# advertir, al cargar la lista, que un correo no parece institucional —
# atrapa errores de digitación sin dejar a nadie fuera de su propia clase.
DOMINIO_INSTITUCIONAL=@monicaherrera.edu.sv

# ---------------------------------------------------------------
# Ya no hay claves de Supabase. La migración a Render + Postgres propio
# eliminó SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY y todo lo relacionado
# a GoTrue/PostgREST. Ver progress.md, entrada de migración a Render.
# ---------------------------------------------------------------
